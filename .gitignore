# Scratch space: labs, repro scripts, throwaway tooling (see CLAUDE.md)
.tmp/

# Per-machine Claude Code settings
.claude/settings.local.json

# Throwaway localhost TLS cert minted on demand by the perf skill's h2 test
# server. Regenerated whenever it is missing; never belongs in a commit.
.claude/skills/perf/.localhost-*.pem

# Env / secrets
.env
.env.local
.env.*.local

# Dependencies / build output
node_modules/
dist/
build/

# OS noise
Thumbs.db
.DS_Store
debug.log

# Browser-automation console logs and snapshots
.playwright-mcp/

# Local-only site assets that must never be committed (e.g. the licensed display face)
site/.local/

# Vercel CLI project link and local build output
.vercel/
