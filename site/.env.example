# GitHub App credentials for the hosted project creator at /new.
# Leave unset and the creator falls back to the GitHub template page.
# Start with: node --env-file=site/.env site/server.mjs
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# At least 32 random bytes. Rotating it disconnects existing creator sessions.
HARNESS_SESSION_SECRET=
